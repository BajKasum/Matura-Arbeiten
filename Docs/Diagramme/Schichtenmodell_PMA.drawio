<mxfile host="app.diagrams.net">
  <diagram name="Schichtenmodell" id="schichten">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="3-Schichten-Modell der Applikation" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="700" height="26" as="geometry" /></mxCell>
        <mxCell id="s" value="Aufrufe gehen nur von oben nach unten · die Anzeige greift nie direkt auf die Datenbank zu" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="700" height="18" as="geometry" /></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;PC, Laptop, Handy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="80" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="l1" value="&lt;b&gt;Presentation Layer (Anzeige)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Controllers: EintragungController, PraesentationController,&lt;br&gt;AccountController, AdminController&lt;br&gt;Views: Razor-Views (.cshtml) mit Bootstrap&lt;br&gt;ViewModels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="180" width="480" height="125" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;b&gt;Business Layer (Logik)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Services: EintragungService, PraesentationService, CsvImportService,&lt;br&gt;AnmeldeService, EmailService, ZuruecksetzenService, ListenService,&lt;br&gt;AdminLoginService, EinstellungService&lt;br&gt;Hier werden alle Regeln geprüft (max. 2, max. 6, keine Terminkollision)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="345" width="480" height="140" as="geometry" /></mxCell>
        <mxCell id="l3" value="&lt;b&gt;Persistence Layer (Datenhaltung)&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppDbContext (Entity Framework Core)&lt;br&gt;Models: G3SuS, Praesentation, Eintragung, EmailVersand, ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="525" width="480" height="90" as="geometry" /></mxCell>
        <mxCell id="db" value="&lt;b&gt;Datenbank&lt;/b&gt;&lt;br&gt;Azure SQL Database&lt;br&gt;(lokal: SQL Server Express)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="740" y="535" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="a0" value="HTTPS-Anfrage" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="l1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a1" value="ruft auf (Interface)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="liest und speichert" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="SQL" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n" value="Die drei Schichten sind Ordner und Namespaces im gleichen ASP.NET-Core-Projekt. Die Controller bekommen die Services über Dependency Injection." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="130" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
