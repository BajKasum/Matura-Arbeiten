        <mxCell id="note_ctrl" value="Loeschen() ist mit [Authorize(Roles = &quot;Administration&quot;)] geschützt. Ein G3-SuS kann sie nicht aufrufen. Der Controller kennt nur das Interface." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="330" height="54" as="geometry" /></mxCell>
        <mxCell id="note_iface" value="EintragungService realisiert IEintragungService (gestrichelte Linie mit leerem Dreieck). ASP.NET Core gibt dem Controller den Service über Dependency Injection." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="330" height="54" as="geometry" /></mxCell>
        <mxCell id="note_svc" value="PruefeRegeln() prüft in dieser Reihenfolge: Eintragungsphase offen, weniger als 2 Eintragungen, freier Platz, keine Terminkollision. Es liefert den ersten verletzten Grund oder nichts." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="note_praes" value="Das Platzkontingent kommt aus der Tabelle systemeinstellung." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="870" y="962" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="note_legende" value="+ public · - private · Properties der Models sind public, weil Entity Framework Core sie liest und schreibt. · string? und DateTime? = darf leer sein" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="962" width="820" height="20" as="geometry" /></mxCell>
