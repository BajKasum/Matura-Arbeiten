<mxfile host="app.diagrams.net">
  <diagram name="MVC" id="mvc">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Das MVC-Muster (Model-View-Controller)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="760" height="26" as="geometry" /></mxCell>
        <mxCell id="s" value="Der Code wird in drei Arten von Klassen aufgeteilt · die Pfeile zeigen, wer wen aufruft" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="760" height="18" as="geometry" /></mxCell>
        <mxCell id="model" value="&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Die Daten.&lt;br&gt;Beispiel: Praesentation mit Thema,&lt;br&gt;Datum, Uhrzeit und Raum." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="view" value="&lt;b&gt;View&lt;/b&gt;&lt;br&gt;&lt;br&gt;Die Seite, die der Benutzer im Browser sieht.&lt;br&gt;Beispiel: Razor-View «Präsentationen auswählen»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nimmt die Anfrage aus dem Browser entgegen und gibt die passende Seite zurück.&lt;br&gt;Beispiel: EintragungController." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e1" value="schickt die Eingabe" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="view" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="gibt die Seite zurück" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="view"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="ändert und liest die Daten" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="liefert die Daten für die Anzeige" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="view"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note" value="So läuft es beim Eintragen (Kapitel 6.1): Der G3-SuS klickt in der View auf «Auswählen».&#10;Der EintragungController nimmt die Anfrage an und lässt die Regeln im Service prüfen.&#10;Danach wird die Eintragung im Model gespeichert, und der Controller gibt die neue Seite zurück.&#10;&#10;In diesem Projekt gibt es dafür die drei Ordner Models, Views und Controllers (Kapitel 2.1)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=8;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="880" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
