        <mxCell id="kante2" value="gehört zu" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;startFill=0;endFill=0;startSize=14;endSize=14;startArrow=ERzeroToMany;endArrow=ERmandOne;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ei_rahmen" target="pr_rahmen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kante3" value="erhält" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;startFill=0;endFill=0;startSize=14;endSize=14;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3_rahmen" target="em_rahmen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legende" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;PK = Primärschlüssel &amp;nbsp;·&amp;nbsp; FK = Fremdschlüssel &amp;nbsp;·&amp;nbsp; UQ = eindeutig (UNIQUE) &amp;nbsp;·&amp;nbsp; (NULL) = darf leer sein&lt;br&gt;||&amp;nbsp; genau eins &amp;nbsp;·&amp;nbsp; o&amp;lt; &amp;nbsp;null bis viele" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="&lt;b&gt;Regeln, die die Logik-Schicht prüft&lt;/b&gt;&lt;br&gt;· höchstens 2 Eintragungen pro G3-SuS&lt;br&gt;· höchstens platzkontingent = 6 Eintragungen pro Präsentation&lt;br&gt;· keine zwei Eintragungen eines G3-SuS mit gleichem Datum und gleicher Uhrzeit&lt;br&gt;&lt;br&gt;&lt;b&gt;In der Datenbank&lt;/b&gt;&lt;br&gt;· UNIQUE (g3sus_id, praesentation_id) in eintragung&lt;br&gt;· ON DELETE CASCADE: g3sus auf eintragung und email_versand, praesentation auf eintragung&lt;br&gt;· administrationslogin und systemeinstellung bleiben beim Zurücksetzen bestehen&lt;br&gt;· passwort_hash ist leer, bis die Zugangsdaten verschickt sind" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="779" width="360" height="210" as="geometry" /></mxCell>
      </root>
