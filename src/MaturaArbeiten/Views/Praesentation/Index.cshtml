@model PraesentationenViewModel
@{
    ViewData["Title"] = "Präsentationen auswählen";
}

@if (TempData["Erfolg"] is string erfolg)
{
    <div class="alert alert-success mb-4" role="status">@erfolg</div>
}

@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-danger mb-4" role="alert">@fehler</div>
}

<h1 class="fs-4 fw-bold text-primary-emphasis">Präsentationen auswählen</h1>
<p class="text-body-secondary mb-4">@Model.GewaehlteAnzahl von @Model.Pflicht Präsentationen gewählt</p>

@if (!Model.PhaseOffen)
{
    <div class="alert alert-warning" role="status">Die Eintragungsphase ist geschlossen. Du kannst keine Präsentation mehr wählen.</div>
}
else if (Model.GewaehlteAnzahl >= Model.Pflicht)
{
    <div class="alert alert-success" role="status">Du hast alle Präsentationen gewählt. Deine Eintragungen findest du unter "Meine Eintragungen".</div>
}
else if (!Model.NochErreichbar)
{
    <div class="alert alert-warning" role="alert">
        Für dich gibt es nicht mehr genug passende Präsentationen. Die Administration sieht das und trägt dich von Hand ein.
    </div>
}

@if (Model.Zeilen.Count == 0)
{
    <p class="text-body-secondary">Im Moment gibt es keine Präsentation, die du wählen kannst.</p>
}
else
{
    <div class="d-none d-md-block">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Thema</th>
                    <th scope="col">Datum</th>
                    <th scope="col">Uhrzeit</th>
                    <th scope="col">Raum</th>
                    <th scope="col">Freie Plätze</th>
                    <th scope="col">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zeile in Model.Zeilen)
                {
                    <tr>
                        <td>@zeile.Thema</td>
                        <td>@zeile.Datum.ToString("dd.MM.yyyy")</td>
                        <td>@zeile.Uhrzeit.ToString("HH:mm")</td>
                        <td>@zeile.Raum</td>
                        <td>@zeile.FreiePlaetze</td>
                        <td>
                            @if (zeile.Gewaehlt)
                            {
                                <span class="badge text-bg-success">Gewählt</span>
                            }
                            else
                            {
                                <form asp-controller="Eintragung" asp-action="WaehlePraesentation" method="post">
                                    <input type="hidden" name="praesentationId" value="@zeile.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Auswählen</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var zeile in Model.Zeilen)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="card-title fs-6 fw-bold">@zeile.Thema</h2>
                    <ul class="list-unstyled text-body-secondary mb-3">
                        <li>@zeile.Datum.ToString("dd.MM.yyyy"), @zeile.Uhrzeit.ToString("HH:mm") Uhr</li>
                        <li>Raum @zeile.Raum</li>
                        <li>Freie Plätze: @zeile.FreiePlaetze</li>
                    </ul>
                    @if (zeile.Gewaehlt)
                    {
                        <span class="badge text-bg-success">Gewählt</span>
                    }
                    else
                    {
                        <form asp-controller="Eintragung" asp-action="WaehlePraesentation" method="post">
                            <input type="hidden" name="praesentationId" value="@zeile.Id" />
                            <button type="submit" class="btn btn-primary w-100">Auswählen</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
