@model ErrorViewModel
@{
    ViewData["Title"] = "Fehler";
}

<h1 class="fs-4 fw-bold text-danger">Es ist ein Fehler aufgetreten</h1>
<p class="text-body-secondary">Deine Anfrage konnte nicht verarbeitet werden. Bitte versuche es später noch einmal.</p>

@if (Model.ShowRequestId)
{
    <p class="text-body-secondary">Fehler-ID: <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Zur Startseite</a>
