@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    var eintraege = new (string Controller, string Text)[]
    {
        ("Admin", "Übersicht"),
        ("AdminPraesentationen", "Präsentationen"),
        ("AdminG3SuS", "G3-SuS verwalten"),
        ("AdminEintragungen", "Eintragungen verwalten"),
        ("AdminLogins", "Administrationslogins"),
        ("Listen", "Listen")
    };
}

<nav class="bg-body-tertiary border-bottom" aria-label="Administration">
    <div class="container-xl">
        <ul class="nav nav-underline flex-nowrap overflow-x-auto">
            @foreach (var (name, text) in eintraege)
            {
                var aktiv = controller == name;

                <li class="nav-item">
                    <a class="nav-link text-nowrap @(aktiv ? "active" : "")" aria-current="@(aktiv ? "page" : null)" asp-controller="@name" asp-action="Index">@text</a>
                </li>
            }
        </ul>
    </div>
</nav>
