<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zusehendenverwaltung</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header class="d-print-none">
        <nav class="navbar navbar-expand-md bg-primary" data-bs-theme="dark" aria-label="Hauptmenü">
            <div class="container-xl">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Zusehendenverwaltung</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#hauptmenue" aria-controls="hauptmenue"
                        aria-expanded="false" aria-label="Menü ein- und ausklappen">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="hauptmenue">
                    <div class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text">@(User.IsInRole(Rollen.Administration) ? "Administration" : "G3-SuS")</span>

                            @if (User.IsInRole(Rollen.G3SuS))
                            {
                                <a class="nav-link" asp-controller="Praesentation" asp-action="Index">Präsentationen auswählen</a>
                                <a class="nav-link" asp-controller="Eintragung" asp-action="MeineEintragungen">Meine Eintragungen</a>
                            }

                            <a class="nav-link" asp-controller="Account" asp-action="PasswortAendern">Passwort ändern</a>
                            <partial name="_Abmelden" />
                        }
                        else
                        {
                            <span class="navbar-text">Wirtschaftsgymnasium Basel</span>
                        }
                    </div>
                </div>
            </div>
        </nav>

        @if (User.IsInRole(Rollen.Administration))
        {
            <partial name="_AdminNavigation" />
        }
    </header>

    <main class="container-xl py-5">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
