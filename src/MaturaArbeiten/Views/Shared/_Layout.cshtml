<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zusehendenverwaltung</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md app-header" data-bs-theme="dark" aria-label="Hauptmenü">
            <div class="container-xl">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Zusehendenverwaltung</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#hauptmenue" aria-controls="hauptmenue"
                        aria-expanded="false" aria-label="Menü ein- und ausklappen">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="hauptmenue">
                    <div class="navbar-nav">
                        @await RenderSectionAsync("HeaderRechts", required: false)
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-xl app-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>