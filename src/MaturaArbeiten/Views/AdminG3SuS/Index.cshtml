@model IReadOnlyList<G3SuSZeile>
@{
    ViewData["Title"] = "G3-SuS verwalten";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-primary-emphasis">G3-SuS verwalten</h1>
        <p class="text-body-secondary mb-0">@Model.Count G3-SuS</p>
    </div>
    <a class="btn btn-primary" asp-action="Neu">G3-SuS anlegen</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">Es sind noch keine G3-SuS geladen.</p>
}
else
{
    <div class="mb-3 col-md-6 col-lg-4">
        <label for="suche" class="form-label visually-hidden">Suchen</label>
        <input type="search" class="form-control" id="suche" placeholder="Nach Name oder E-Mail suchen" data-filtertabelle="g3sus-tabelle" autocomplete="off" />
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle" id="g3sus-tabelle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Nachname</th>
                    <th scope="col">Vorname</th>
                    <th scope="col">E-Mail</th>
                    <th scope="col">Eintragungen</th>
                    <th scope="col">Zugangsdaten</th>
                    <th scope="col">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zeile in Model)
                {
                    <tr>
                        <td>@zeile.Nachname</td>
                        <td>@zeile.Vorname</td>
                        <td>@zeile.Email</td>
                        <td>@zeile.Eintragungen</td>
                        <td>
                            @if (zeile.HatPasswort)
                            {
                                <span class="badge text-bg-success">verschickt</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">noch nicht</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Bearbeiten" asp-route-id="@zeile.Id">Ändern</a>
                            <form asp-action="ZugangsdatenSenden" asp-route-id="@zeile.Id" method="post" class="d-inline"
                                  data-rueckfrage="Neue Zugangsdaten verschicken? Das bisherige Passwort gilt dann nicht mehr.">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Neue Zugangsdaten</button>
                            </form>
                            <form asp-action="Loeschen" asp-route-id="@zeile.Id" method="post" class="d-inline"
                                  data-rueckfrage="@($"{zeile.Vorname} {zeile.Nachname} wirklich löschen? Die Eintragungen werden mitgelöscht.")">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Löschen</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
