@model AnmeldenViewModel
@{
    ViewData["Title"] = "Anmelden";
}

@section HeaderRechts {
    <span class="navbar-text">Wirtschaftsgymnasium Basel</span>
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card card-body p-4">
            <h1 class="fs-4 fw-bold text-primary-emphasis mb-4">Anmelden</h1>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    @foreach (var fehler in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@fehler.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Anmelden">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-Mail-Adresse</label>
                    <input asp-for="Email" type="email" class="form-control"
                           placeholder="vorname.nachname@@stud.edubs.ch"
                           autocomplete="username" maxlength="100" required />
                </div>

                <div class="mb-4">
                    <label asp-for="Passwort" class="form-label">Passwort</label>
                    <input asp-for="Passwort" type="password" class="form-control"
                           autocomplete="current-password" maxlength="100" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Anmelden</button>
            </form>

            <p class="text-center text-body-secondary small mt-4 mb-0">Die Zugangsdaten wurden per E-Mail zugestellt.</p>
        </div>
    </div>
</div>