@model ZuruecksetzenViewModel
@{
    ViewData["Title"] = "Schuljahr zurücksetzen";
}

<h1 class="fs-4 fw-bold text-danger">Schuljahr zurücksetzen</h1>

<div class="alert alert-warning my-4" role="alert">
    <p class="mb-2">Willst du das Schuljahr wirklich zurücksetzen? Dabei werden gelöscht:</p>
    <ul class="mb-2">
        <li>@Model.AnzahlG3SuS G3-SuS</li>
        <li>@Mehrzahl.Von(Model.AnzahlPraesentationen, "Präsentation", "Präsentationen")</li>
        <li>@Mehrzahl.Von(Model.AnzahlEintragungen, "Eintragung", "Eintragungen")</li>
        <li>@Mehrzahl.Von(Model.AnzahlEmails, "Eintrag", "Einträge") im E-Mail-Protokoll</li>
    </ul>
    <p class="mb-0">Die Administrationslogins bleiben bestehen. Die Eintragungsphase wird wieder geöffnet.</p>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-outline-primary" asp-action="Index">Abbrechen</a>
    <a class="btn btn-danger" asp-action="ZuruecksetzenBestaetigen">Ja, weiter</a>
</div>
