@model ImportErgebnisViewModel
@{
    ViewData["Title"] = "Import " + Model.Titel;
}

@section HeaderRechts {
    <span class="navbar-text">Administration</span>
    <a class="nav-link" asp-action="Index">Übersicht</a>
    <partial name="_Abmelden" />
}

<h1 class="fs-4 fw-bold text-primary-emphasis">Import: @Model.Titel</h1>

<div class="alert @(Model.Geladen > 0 ? "alert-success" : "alert-warning") my-4" role="status">
    @Model.Geladen geladen, @Model.Fehler.Count übersprungen.
</div>

@if (Model.Fehler.Count > 0)
{
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th scope="col">Zeile</th>
                <th scope="col">Grund</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var zeile in Model.Fehler)
            {
                <tr>
                    <td>@zeile.Zeile</td>
                    <td>@zeile.Grund</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-outline-primary" asp-action="Index">Zurück zur Administration</a>