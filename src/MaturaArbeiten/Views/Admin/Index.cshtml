@{
    ViewData["Title"] = "Administration";
}

@section HeaderRechts {
    <span class="navbar-text">Administration</span>
    <a class="nav-link" href="#">Passwort ändern</a>
    <partial name="_Abmelden" />
}

@section Unternavigation {
    <nav class="bg-body-tertiary border-bottom" aria-label="Administration">
        <div class="container-xl">
            <ul class="nav nav-underline">
                <li class="nav-item"><a class="nav-link active" aria-current="page" href="#">Übersicht</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Präsentationen</a></li>
                <li class="nav-item"><a class="nav-link" href="#">G3-SuS verwalten</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Eintragungen verwalten</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Administrationslogins</a></li>
            </ul>
        </div>
    </nav>
}

@if (TempData["Erfolg"] is string erfolg)
{
    <div class="alert alert-success mb-4" role="status">@erfolg</div>
}

@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-danger mb-4" role="alert">@fehler</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-primary-emphasis">Administration</h1>
        <p class="text-body-secondary mb-0">Eintragungsphase: <strong>offen</strong> · 87 von 100 G3-SuS haben zwei Präsentationen gewählt</p>
    </div>
    <button type="button" class="btn btn-outline-primary">Eintragungsphase schliessen</button>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <section class="card h-100">
            <div class="card-body p-4">
                <h2 class="card-title fs-5 fw-bold mb-0">Daten laden</h2>
                <p class="text-body-secondary small mt-2 mb-0">CSV-Datei in UTF-8, getrennt mit Semikolon, erste Zeile mit den Spaltennamen.</p>

                <form asp-action="ImportPraesentationen" method="post" enctype="multipart/form-data" class="mt-3">
                    <label for="praesentationenDatei" class="form-label">Präsentationen (Thema; Datum; Uhrzeit; Raum)</label>
                    <div class="d-flex gap-2">
                        <input type="file" class="form-control" id="praesentationenDatei" name="datei" accept=".csv" required />
                        <button type="submit" class="btn btn-primary">Importieren</button>
                    </div>
                </form>

                <form asp-action="ImportG3SuS" method="post" enctype="multipart/form-data" class="mt-3">
                    <label for="g3susDatei" class="form-label">G3-SuS (Vorname; Nachname; E-Mail)</label>
                    <div class="d-flex gap-2">
                        <input type="file" class="form-control" id="g3susDatei" name="datei" accept=".csv" required />
                        <button type="submit" class="btn btn-primary">Importieren</button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-md-6">
        <section class="card h-100">
            <div class="card-body p-4">
                <h2 class="card-title fs-5 fw-bold mb-0">E-Mail-Versand</h2>
                <form asp-action="ZugangsdatenVersenden" method="post" class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span>Zugangsdaten an G3-SuS ohne Passwort</span>
                    <button type="submit" class="btn btn-primary">Versenden</button>
                </form>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span>Bestätigungen an G3-SuS mit 2 Eintragungen</span>
                    <button type="button" class="btn btn-primary">Versenden</button>
                </div>
                <p class="mt-4 mb-0">Versendet: 100 von 100</p>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span>Fehlgeschlagen: 0 <a class="ms-3" href="#">Liste anzeigen</a></span>
                    <button type="button" class="btn btn-outline-primary">Erneut senden</button>
                </div>
            </div>
        </section>
    </div>

    <div class="col-md-6">
        <section class="card h-100">
            <div class="card-body p-4">
                <h2 class="card-title fs-5 fw-bold mb-0">Listen erzeugen</h2>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span>Raumübersicht</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary">Anzeigen</button>
                        <button type="button" class="btn btn-outline-primary">CSV</button>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span>Zuseherliste je Präsentation</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary">Anzeigen</button>
                        <button type="button" class="btn btn-outline-primary">CSV</button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-md-6">
        <section class="card border-danger h-100">
            <div class="card-body p-4">
                <h2 class="card-title fs-5 fw-bold mb-0 text-danger">Schuljahr zurücksetzen</h2>
                <p class="mt-3 text-body-secondary">Löscht alle G3-SuS, alle Präsentationen, alle Eintragungen und das E-Mail-Protokoll. Die Administrationslogins bleiben bestehen.</p>
                <button type="button" class="btn btn-danger">Zurücksetzen</button>
            </div>
        </section>
    </div>
</div>