@model MeineEintragungenViewModel
@{
    ViewData["Title"] = "Meine Eintragungen";
}

@if (TempData["Erfolg"] is string erfolg)
{
    <div class="alert alert-success mb-4" role="status">@erfolg</div>
}

@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-warning mb-4" role="alert">@fehler</div>
}

@if (Model.PflichtErfuellt)
{
    <div class="alert alert-success mb-4" role="status">Pflichtbesuch erfüllt.</div>
}
else
{
    <div class="alert alert-info mb-4" role="status">
        Du hast erst @Model.Zeilen.Count von @Model.Pflicht Präsentationen gewählt.
        <a class="alert-link" asp-controller="Praesentation" asp-action="Index">Präsentationen auswählen</a>
    </div>
}

<h1 class="fs-4 fw-bold text-primary-emphasis">Meine Eintragungen</h1>
<p class="text-body-secondary mb-4">@Model.Zeilen.Count von @Model.Pflicht Präsentationen gewählt</p>

@if (Model.Zeilen.Count == 0)
{
    <p class="text-body-secondary">Du hast noch keine Präsentation gewählt.</p>
}
else
{
    <div class="d-none d-md-block">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Thema</th>
                    <th scope="col">Datum</th>
                    <th scope="col">Uhrzeit</th>
                    <th scope="col">Raum</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zeile in Model.Zeilen)
                {
                    <tr>
                        <td>@zeile.Thema</td>
                        <td>@zeile.Datum.ToString("dd.MM.yyyy")</td>
                        <td>@zeile.Uhrzeit.ToString("HH:mm")</td>
                        <td>@zeile.Raum</td>
                        <td><span class="badge text-bg-success">Eingetragen</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var zeile in Model.Zeilen)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="card-title fs-6 fw-bold">@zeile.Thema</h2>
                    <ul class="list-unstyled text-body-secondary mb-3">
                        <li>@zeile.Datum.ToString("dd.MM.yyyy"), @zeile.Uhrzeit.ToString("HH:mm") Uhr</li>
                        <li>Raum @zeile.Raum</li>
                    </ul>
                    <span class="badge text-bg-success">Eingetragen</span>
                </div>
            </div>
        }
    </div>
}

<p class="mt-4 text-body-secondary">Änderungen an den Eintragungen sind nur über die Administration möglich.</p>