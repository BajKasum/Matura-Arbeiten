@model PersonFormular
@{
    var neu = ViewContext.RouteData.Values["action"]?.ToString() == "Neu";
    ViewData["Title"] = neu ? "Administrationslogin anlegen" : "Administrationslogin ändern";
    ViewData["Hinweis"] = neu ? "Die Zugangsdaten werden nach dem Speichern an diese Adresse verschickt." : null;
}

<partial name="_PersonFormular" />
