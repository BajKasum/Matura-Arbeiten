@model EmailProtokollViewModel
@{
    ViewData["Title"] = "Fehlgeschlagene E-Mails";
}

@if (TempData["Erfolg"] is string erfolg)
{
    <div class="alert alert-success mb-4" role="status">@erfolg</div>
}

@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-danger mb-4" role="alert">@fehler</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-primary-emphasis">Fehlgeschlagene E-Mails</h1>
        <p class="text-body-secondary mb-0">
            Jede E-Mail steht hier, bis sie erfolgreich verschickt ist. Ein erneuter Versand erzeugt einen neuen Eintrag im Protokoll.
        </p>
    </div>
    @if (Model.Zeilen.Count > 0)
    {
        <form asp-action="AlleErneutSenden" method="post">
            <button type="submit" class="btn btn-primary">Alle erneut senden</button>
        </form>
    }
</div>

@if (Model.Zeilen.Count == 0)
{
    <p class="text-body-secondary">Es gibt keine fehlgeschlagenen E-Mails.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">G3-SuS</th>
                    <th scope="col">E-Mail</th>
                    <th scope="col">Versucht am</th>
                    <th scope="col">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zeile in Model.Zeilen)
                {
                    <tr>
                        <td>@zeile.G3SuS</td>
                        <td>@(zeile.Typ == "Bestaetigung" ? "Bestätigung" : zeile.Typ)</td>
                        <td>@Zeitzone.InZuerich(zeile.Zeit).ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form asp-action="ErneutSenden" asp-route-id="@zeile.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Erneut senden</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
